# ===========================================
# SDCP Social Post Generator - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values

# Application
# -------------------------------------------
DEBUG=false
SECRET_KEY=your-secret-key-change-in-production
BASE_URL=https://sdcp-social.up.railway.app

# Database (Railway provides this automatically)
# -------------------------------------------
DATABASE_URL=postgresql://user:password@host:port/database

# Anthropic / Claude AI
# -------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514

# Postmark Email Service
# -------------------------------------------
# Get from: https://postmarkapp.com/
POSTMARK_SERVER_TOKEN=your-postmark-server-token
POSTMARK_INBOUND_ADDRESS=posts@inbound.postmarkapp.com

# Meta / Facebook / Instagram
# -------------------------------------------
# See setup guide in README for obtaining these
META_ACCESS_TOKEN=your-meta-access-token
FACEBOOK_PAGE_ID=your-facebook-page-id
INSTAGRAM_BUSINESS_ACCOUNT_ID=your-instagram-business-account-id

# Approval Workflow
# -------------------------------------------
# Comma-separated list of email addresses
APPROVAL_EMAIL_RECIPIENTS=emily@sdcustompainting.com
APPROVAL_TOKEN_EXPIRY_HOURS=72

# Photo Storage
# -------------------------------------------
PHOTO_STORAGE_PATH=./uploads

# Timezone
# -------------------------------------------
TIMEZONE=America/Los_Angeles

# Default publish time (24-hour format)
# -------------------------------------------
DEFAULT_PUBLISH_HOUR=10
DEFAULT_PUBLISH_MINUTE=0

# Dashboard Authentication
# -------------------------------------------
# Password for the web dashboard (leave empty to use SECRET_KEY)
DASHBOARD_PASSWORD=your-dashboard-password
